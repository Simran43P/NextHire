# NextHire frontend configuration.
#
# Copy to frontend/.env.local and edit. Both values are optional - the defaults
# below are what the app uses when no file is present.
#
# Vite only exposes variables prefixed with VITE_ to the browser.

# Where the FastAPI backend is listening.
VITE_API_BASE_URL=http://localhost:8000/api

# Client-side upload cap, in megabytes. Keep this in step with MAX_UPLOAD_MB in
# backend/.env - the server enforces the real limit, this only fails faster.
VITE_MAX_UPLOAD_MB=5
