# NextHire backend configuration.
#
# Copy to backend/.env and edit. Every value below is optional - the app runs
# with no .env at all, using the defaults shown here.

# --- Job search --------------------------------------------------------------

# RapidAPI key for JSearch. Without one, job search automatically serves the
# built-in sample postings instead, so the app still works end to end.
# Get a free key at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Force sample postings even when a key IS configured. Keep this on during
# development: every live search spends one API call per selected job title,
# and the free tier is small.
USE_MOCK_JOBS=true

# Two-letter country code for job search.
DEFAULT_COUNTRY=in

JOB_SEARCH_TIMEOUT_SECONDS=60


# --- Local model (Ollama) ----------------------------------------------------

# Install Ollama from https://ollama.com, then: ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b

# Hard ceilings in seconds. Lower these on capable hardware; a 7B model on CPU
# is genuinely slow, which is why the defaults are generous.
EXTRACTION_TIMEOUT_SECONDS=300
INFERENCE_TIMEOUT_SECONDS=90
ATS_TIMEOUT_SECONDS=120

# How many model calls may run at once. A single Ollama instance serving one
# model does not parallelise well, so keep this low. The client still fires
# requests in parallel and renders each result as it lands.
LLM_CONCURRENCY=2

# Context window for extraction. Must stay large enough that multi-page resumes
# are not silently truncated.
EXTRACTION_NUM_CTX=8192


# --- Uploads -----------------------------------------------------------------

MAX_UPLOAD_MB=5

# A PDF extracting to fewer characters than this is treated as a scan and
# rejected, rather than sent to the model as an empty string.
MIN_RESUME_CHARS=200


# --- HTTP --------------------------------------------------------------------

# Comma-separated. "*" is not accepted: browsers reject it alongside
# credentials, and it is unsafe once authentication exists.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# --- Persistence -------------------------------------------------------------

# SQLite by default: no server to run, and the whole database is one file you
# can copy, inspect, or delete. Point at Postgres if there is ever more than
# one instance.
DATABASE_URL=sqlite+aiosqlite:///./nexthire.db

# Where uploaded resumes are written, under random keys.
STORAGE_DIR=./storage


# --- Authentication ----------------------------------------------------------

SESSION_COOKIE_NAME=nexthire_session
SESSION_TTL_DAYS=30

# Leave false for local http development. Set true anywhere served over https.
COOKIE_SECURE=false
# "lax" suits a same-site setup; cross-site cookies need "none", which browsers
# only accept alongside Secure.
COOKIE_SAMESITE=lax

PASSWORD_RESET_TTL_MINUTES=30
MIN_PASSWORD_LENGTH=10


# --- Rate limiting -----------------------------------------------------------

RATE_LIMIT_ENABLED=true
RATE_LIMIT_INFERENCE_PER_HOUR=60
RATE_LIMIT_UPLOAD_PER_HOUR=20
RATE_LIMIT_AUTH_PER_HOUR=20


# --- Password reset email (optional) -----------------------------------------

# With no SMTP_HOST, reset links are printed to the server log instead of
# emailed - which is all a single-user local install needs, and costs nothing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nexthire@localhost

# Used to build the link inside a reset email.
APP_BASE_URL=http://localhost:5173
